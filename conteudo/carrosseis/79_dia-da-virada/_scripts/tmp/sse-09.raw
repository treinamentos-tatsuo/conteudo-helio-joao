data: {"type":"response.output_item.done","item":{"id":"ig_0988565b028c98e1016a97270eb40c87d2a978b46b030ffb02","type":"image_generation_call","status":"completed","action":"generate","background":"opaque","output_format":"png","quality":"low","result":"","revised_prompt":"Old two-pan shop balance scale on a counter in a humble Brazilian small-business setting, documentary realism. The two pans are almost level, and a single small brass weight sits on the edge of one pan, with a fingertip about to lift it off. The tiny thing that decides everything. The scale is positioned LOW and slightly RIGHT in the frame, with a large empty pale upper half/upper space for clean compositing. No markings, no numbers, no text, no letters, no logos anywhere on the scale or in the scene. Black-and-white editorial vintage documentary photograph, desaturated, high contrast, grainy film texture, authentic lived-in details, humble and real, never corporate. Wide horizontal landscape composition, 3:2 aspect ratio, much wider than tall. No added color, no gradients, no stock photo look.","size":"1536x1024"},"output_index":0,"sequence_number":6}

