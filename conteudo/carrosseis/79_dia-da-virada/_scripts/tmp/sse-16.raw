data: {"type":"response.output_item.done","item":{"id":"ig_06da2fb57447b92a016a973509cfc087d290bf6c1f27779818","type":"image_generation_call","status":"completed","action":"generate","background":"opaque","output_format":"png","quality":"low","result":"","revised_prompt":"Black-and-white editorial vintage documentary photograph, desaturated, high contrast, grainy film. Brazilian small-business setting, humble and real, never corporate. Two hands hanging a BRAND NEW clean paper wall calendar on a nail on a shop wall; the calendar page is completely fresh with not a single day crossed out. The hands and the calendar are LARGE in the frame, filling the lower two thirds and reaching up toward the middle so there is NO wide empty gap above them. Subject sits LOW in the frame with a large pale and empty upper half for clean compositing. Shallow depth of field: every printed number and word on the page is completely BLURRED and ILLEGIBLE, soft grey smudges; only the empty grid squares read clearly. No text, no words, no letters, no numbers, no logos, no emojis, no gradients, no added color, no stock photo look. WIDE HORIZONTAL LANDSCAPE orientation, 3:2 aspect ratio, much wider than tall.","size":"1536x1024"},"output_index":0,"sequence_number":6}

