event: response.output_item.done
data: {"type":"response.output_item.done","item":{"id":"ig_06c3c55317734095016a97380e075087d2990d69d5bade6f80","type":"image_generation_call","status":"completed","action":"generate","background":"opaque","output_format":"png","quality":"medium","result":"","revised_prompt":"Black-and-white editorial vintage documentary photograph, desaturated, high contrast, grainy film texture. Wide horizontal landscape, 3:2 aspect ratio. A single-file queue of four people lined up one behind the other waiting to be paid at a small humble Brazilian shop counter. They stand in profile facing left toward the counter. Front: a delivery supplier in work clothes. Behind them: a woman employee. Behind her: a man in a plain shirt holding a folder. Fourth person behind in the line, also ordinary working-class. The people are LARGE in frame and fill the lower two thirds, with their heads reaching toward the middle of the image, leaving an open pale upper half for clean compositing but without an awkward huge gap directly above their heads. Plain pale wall behind. Small-business setting, humble and real, never corporate. No text, no words, no letters, no numbers, no logos, no emojis, no color, no gradients, no stock photo look. Strong documentary realism, natural poses, simple shop counter visible at left, uncluttered background, authentic 20th-century archival feel.","size":"1536x1024"},"output_index":1,"sequence_number":9}

